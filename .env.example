# ---------------------------------------------------------------------------
# NextGen Predict — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project URL. Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/publishable key. Safe to expose — RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER ONLY — bypasses RLS entirely.
# Used solely for aggregate public statistics on the landing page.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute site URL, used for auth callbacks, referral links and every
# canonical/sitemap/OG URL. No trailing slash.
# Local: http://localhost:3000 — Production: https://nextgenpredict.com
NEXT_PUBLIC_SITE_URL=https://nextgenpredict.com

# Shared secret for the one-time admin bootstrap endpoint at
# /api/setup/promote-admin. After your first sign-up with foysalqbl@gmail.com,
# curl the endpoint once:  curl -XPOST -H "Authorization: Bearer $ADMIN_SETUP_SECRET" \
#   https://your-domain.com/api/setup/promote-admin
# Generate with: openssl rand -hex 32
ADMIN_SETUP_SECRET=your-admin-setup-secret

# Shared secret for the scheduled job at /api/cron/close-markets, which closes
# markets past their end time. Vercel Cron sends it as `Authorization: Bearer …`.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret
